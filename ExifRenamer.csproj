<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows7.0</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<OutputType>WinExe</OutputType>
		<RootNamespace>ExifImageRenamer</RootNamespace>
		<AssemblyName>ExifImageRenamer</AssemblyName>
		<StartupObject>ExifFileRenamer.Program</StartupObject>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
		<Optimize>false</Optimize>
		<OutputPath>bin\Debug\</OutputPath>
		<DefineConstants>DEBUG;TRACE</DefineConstants>
		<WarningLevel>4</WarningLevel>
		<Prefer32Bit>false</Prefer32Bit>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
		<DebugType>pdbonly</DebugType>
		<Optimize>true</Optimize>
		<OutputPath>bin\Release\</OutputPath>
		<DefineConstants>TRACE</DefineConstants>
		<WarningLevel>4</WarningLevel>
		<Prefer32Bit>false</Prefer32Bit>
	</PropertyGroup>

	<!-- Fallback for unusual combinations -->
	<PropertyGroup>
		<OutputPath Condition=" '$(OutputPath)' == '' ">bin\$(Configuration)\</OutputPath>
		<BaseOutputPath Condition=" '$(BaseOutputPath)' == '' ">bin\</BaseOutputPath>
		<IntermediateOutputPath Condition=" '$(IntermediateOutputPath)' == '' ">obj\$(Configuration)\</IntermediateOutputPath>
		<UseWPF>False</UseWPF>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="Code\ApplicationState.cs" />
		<Compile Include="Common\Constants.cs" />
		<Compile Include="Code\FileNameTemplateFactory.cs" />
		<Compile Include="Code\FileNameFactory.cs" />
		<Compile Include="Code\ImageInfoExtractorService.cs" />
		<Compile Include="Interfaces\ISettingsProvider.cs" />
		<Compile Include="Model\ImageInfo.cs" />
		<Compile Include="Model\ExifInfo.cs" />
		<Compile Include="Interfaces\IProcessingFileInfo.cs" />
		<Compile Include="Properties\AssemblyInfo.cs" />
		<Compile Include="Model\Settings.cs" />
		<Compile Include="Code\ExifInfoExtractorService.cs" />
		<Compile Include="Code\ExifWriterService.cs" />
		<Compile Include="Code\JpegExifRewriter.cs" />
		<Compile Include="Model\ExifEditValues.cs" />
		<Compile Include="ExifEditForm.cs">
			<SubType>Form</SubType>
		</Compile>
		<Compile Include="AboutForm.cs">
			<SubType>Form</SubType>
		</Compile>
		<Compile Include="TimeShiftForm.cs">
			<SubType>Form</SubType>
		</Compile>
		<Compile Include="AddExifForm.cs">
			<SubType>Form</SubType>
		</Compile>
		<Compile Include="Code\RegistrySettingsProvider.cs" />
		<Compile Include="Code\RenameBatchValidator.cs" />
		<Compile Include="Form1.cs">
			<SubType>Form</SubType>
		</Compile>
		<Compile Include="Form1.Designer.cs">
			<DependentUpon>Form1.cs</DependentUpon>
		</Compile>
		<Compile Include="HelpForm.cs">
			<SubType>Form</SubType>
		</Compile>
		<Compile Include="HelpForm.Designer.cs">
			<DependentUpon>HelpForm.cs</DependentUpon>
		</Compile>
		<Compile Include="Model\ProcessingFileInfo.cs" />
		<Compile Include="Program.cs" />
		<Compile Include="Model\SourceFileInfo.cs" />
		<Compile Include="Properties\Resources.Designer.cs">
			<AutoGen>True</AutoGen>
			<DesignTime>True</DesignTime>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
		<Compile Include="TestFriends.cs" />
		<EmbeddedResource Include="Form1.resx">
			<SubType>Designer</SubType>
			<DependentUpon>Form1.cs</DependentUpon>
		</EmbeddedResource>
		<EmbeddedResource Include="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<SubType>Designer</SubType>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<None Include="app.config" />
		<None Include="ClassDiagram1.cd" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Resources\" />
	</ItemGroup>


</Project>